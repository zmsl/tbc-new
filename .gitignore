# MCP presets, copied out of ui/ at build time
mcp/internal/presets/files/*
!mcp/internal/presets/files/.gitkeep

# electron desktop shell
desktop/node_modules
# Generated at build time: the app icon is copied in from assets/, and the sidecar binaries are
# compiled by the makefile. installer.nsh is hand-written and has to survive.
desktop/build/*
!desktop/build/installer.nsh
desktop-dist/
