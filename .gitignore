.DS_Store

# air tmp dir
tmp/

# lib
wowsimtbc*.so
wowsimtbc*.dll
wowsimtbc*.h
wowsims.db
assets/db_inputs/dbc/
tbc.sln

.claude
tools/db2tool/listfile.csv
