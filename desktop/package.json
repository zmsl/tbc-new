{
	"name": "wowsimtbc-desktop",
	"productName": "WoWSims TBC",
	"version": "0.0.0",
	"description": "Desktop shell for the WoW Burning Crusade Classic simulator",
	"license": "MIT",
	"author": "wowsims",
	"main": "main.js",
	"private": true,
	"scripts": {
		"start": "electron .",
		"pack": "electron-builder --dir",
		"dist:win": "electron-builder --win nsis --publish never",
		"dist:mac": "electron-builder --mac dmg zip --publish never"
	},
	"dependencies": {
		"electron-updater": "6.8.9"
	},
	"devDependencies": {
		"@fortawesome/fontawesome-free": "^6.7.2",
		"electron": "44.2.0",
		"electron-builder": "26.15.3"
	}
}
